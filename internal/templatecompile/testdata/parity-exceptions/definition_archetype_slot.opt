<?xml version="1.0" encoding="UTF-8"?>
<!-- SDK-authored parity fixture: a definition typed ARCHETYPE_SLOT, which the parser reads as a slot and the model's reader refuses, since the model's definition, an archetype root, cannot hold one, an exception the parity rule allows. -->
<template xmlns="http://schemas.openehr.org/v1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <language>
    <terminology_id><value>ISO_639-1</value></terminology_id>
    <code_string>en</code_string>
  </language>
  <template_id><value>parity.definition_archetype_slot.v1</value></template_id>
  <concept>Parity</concept>
  <definition xsi:type="ARCHETYPE_SLOT">
    <rm_type_name>CLUSTER</rm_type_name>
    <occurrences><lower>1</lower><upper>1</upper></occurrences>
    <node_id>at0000</node_id>
    <includes>
      <string_expression>archetype_id/value matches {/openEHR-EHR-CLUSTER\.device\.v1/}</string_expression>
    </includes>
  </definition>
</template>
