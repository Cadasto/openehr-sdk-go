<?xml version="1.0" encoding="UTF-8"?>
<!-- SDK-authored parity fixture: two default values the compile step cannot hold as canonical JSON, a DV_QUANTITY with a NaN magnitude and one with an infinite magnitude, which it skips in its default mode and refuses in its strict mode, beside one it places. -->
<template xmlns="http://schemas.openehr.org/v1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <language>
    <terminology_id><value>ISO_639-1</value></terminology_id>
    <code_string>en</code_string>
  </language>
  <template_id><value>parity.default_value_not_canonical_json.v1</value></template_id>
  <concept>Parity</concept>
  <definition>
    <rm_type_name>COMPOSITION</rm_type_name>
    <occurrences><lower>1</lower><upper>1</upper></occurrences>
    <node_id>at0000</node_id>
    <attributes xsi:type="C_SINGLE_ATTRIBUTE">
      <rm_attribute_name>context</rm_attribute_name>
      <existence><lower>1</lower><upper>1</upper></existence>
      <children xsi:type="C_COMPLEX_OBJECT">
        <rm_type_name>EVENT_CONTEXT</rm_type_name>
        <occurrences><lower>1</lower><upper>1</upper></occurrences>
        <node_id/>
        <attributes xsi:type="C_SINGLE_ATTRIBUTE">
          <rm_attribute_name>other_context</rm_attribute_name>
          <existence><lower>0</lower><upper>1</upper></existence>
          <children xsi:type="C_COMPLEX_OBJECT">
            <rm_type_name>ITEM_TREE</rm_type_name>
            <occurrences><lower>1</lower><upper>1</upper></occurrences>
            <node_id>at0001</node_id>
            <attributes xsi:type="C_MULTIPLE_ATTRIBUTE">
              <rm_attribute_name>items</rm_attribute_name>
              <existence><lower>0</lower><upper>1</upper></existence>
              <children xsi:type="C_COMPLEX_OBJECT">
                <rm_type_name>ELEMENT</rm_type_name>
                <occurrences><lower>0</lower><upper>1</upper></occurrences>
                <node_id>at0002</node_id>
                <attributes xsi:type="C_SINGLE_ATTRIBUTE">
                  <rm_attribute_name>value</rm_attribute_name>
                  <existence><lower>0</lower><upper>1</upper></existence>
                  <children xsi:type="C_COMPLEX_OBJECT">
                    <rm_type_name>DV_QUANTITY</rm_type_name>
                    <occurrences><lower>0</lower><upper>1</upper></occurrences>
                    <node_id/>
                  </children>
                </attributes>
              </children>
              <children xsi:type="C_COMPLEX_OBJECT">
                <rm_type_name>ELEMENT</rm_type_name>
                <occurrences><lower>0</lower><upper>1</upper></occurrences>
                <node_id>at0003</node_id>
                <attributes xsi:type="C_SINGLE_ATTRIBUTE">
                  <rm_attribute_name>value</rm_attribute_name>
                  <existence><lower>0</lower><upper>1</upper></existence>
                  <children xsi:type="C_COMPLEX_OBJECT">
                    <rm_type_name>DV_TEXT</rm_type_name>
                    <occurrences><lower>0</lower><upper>1</upper></occurrences>
                    <node_id/>
                  </children>
                </attributes>
              </children>
              <children xsi:type="C_COMPLEX_OBJECT">
                <rm_type_name>ELEMENT</rm_type_name>
                <occurrences><lower>0</lower><upper>1</upper></occurrences>
                <node_id>at0004</node_id>
                <attributes xsi:type="C_SINGLE_ATTRIBUTE">
                  <rm_attribute_name>value</rm_attribute_name>
                  <existence><lower>0</lower><upper>1</upper></existence>
                  <children xsi:type="C_COMPLEX_OBJECT">
                    <rm_type_name>DV_QUANTITY</rm_type_name>
                    <occurrences><lower>0</lower><upper>1</upper></occurrences>
                    <node_id/>
                  </children>
                </attributes>
              </children>
              <cardinality>
                <is_ordered>false</is_ordered>
                <is_unique>false</is_unique>
                <interval><lower>0</lower><upper_unbounded>true</upper_unbounded></interval>
              </cardinality>
            </attributes>
          </children>
        </attributes>
      </children>
    </attributes>
    <archetype_id><value>openEHR-EHR-COMPOSITION.parity.v1</value></archetype_id>
    <term_definitions code="at0000"><items id="text">Parity</items></term_definitions>
    <term_definitions code="at0001"><items id="text">Tree</items></term_definitions>
    <term_definitions code="at0002"><items id="text">Pressure</items></term_definitions>
    <term_definitions code="at0003"><items id="text">Comment</items></term_definitions>
    <term_definitions code="at0004"><items id="text">Rate</items></term_definitions>
  </definition>
  <constraints>
    <attributes>
      <rm_attribute_name>value</rm_attribute_name>
      <children>
        <rm_type_name>DV_QUANTITY</rm_type_name>
        <occurrences><lower>1</lower><upper>1</upper></occurrences>
        <node_id/>
        <default_value xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="DV_QUANTITY"><magnitude>NaN</magnitude><units>mm[Hg]</units></default_value>
      </children>
      <differential_path>[openEHR-EHR-COMPOSITION.parity.v1]/context/other_context[at0001]/items[at0002]</differential_path>
    </attributes>
    <attributes>
      <rm_attribute_name>value</rm_attribute_name>
      <children>
        <rm_type_name>DV_TEXT</rm_type_name>
        <occurrences><lower>1</lower><upper>1</upper></occurrences>
        <node_id/>
        <default_value xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="DV_TEXT"><value>placed</value></default_value>
      </children>
      <differential_path>[openEHR-EHR-COMPOSITION.parity.v1]/context/other_context[at0001]/items[at0003]</differential_path>
    </attributes>
    <attributes>
      <rm_attribute_name>value</rm_attribute_name>
      <children>
        <rm_type_name>DV_QUANTITY</rm_type_name>
        <occurrences><lower>1</lower><upper>1</upper></occurrences>
        <node_id/>
        <default_value xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="DV_QUANTITY"><magnitude>INF</magnitude><units>/min</units></default_value>
      </children>
      <differential_path>[openEHR-EHR-COMPOSITION.parity.v1]/context/other_context[at0001]/items[at0004]</differential_path>
    </attributes>
  </constraints>
</template>
