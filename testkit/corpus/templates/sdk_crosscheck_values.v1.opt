        <term_definitions code="at0000">
          <items id="description">A synthetic observation written for openehr-sdk-go tests.</items>
          <items id="text">SDK values</items>
        </term_definitions>
        <term_definitions code="at0001">
          <items id="description">@ internal @</items>
          <items id="text">Event Series</items>
        </term_definitions>
        <term_definitions code="at0002">
          <items id="description">*</items>
          <items id="text">Any event</items>
        </term_definitions>
        <term_definitions code="at0003">
          <items id="description">@ internal @</items>
          <items id="text">Tree</items>
        </term_definitions>
        <term_definitions code="at0004">
          <items id="description">A C_STRING list with list_open true.</items>
          <items id="text">Text from an open list</items>
        </term_definitions>
        <term_definitions code="at0005">
          <items id="description">A DV_QUANTITY constrained by property only.</items>
          <items id="text">Pressure by property</items>
        </term_definitions>
        <term_definitions code="at0006">
          <items id="description">A date whose pattern forbids the day.</items>
          <items id="text">Partial date</items>
        </term_definitions>
        <term_definitions code="at0007">
          <items id="description">A time whose pattern forbids the seconds, with no time zone.</items>
          <items id="text">Partial time</items>
        </term_definitions>
        <term_definitions code="at0008">
          <items id="description">A date-time with a pattern, a mandatory time zone and a range.</items>
          <items id="text">Date-time in a range</items>
        </term_definitions>
        <term_definitions code="at0009">
          <items id="description">A date with a range.</items>
          <items id="text">Date in a range</items>
        </term_definitions>
        <term_definitions code="at0010">
          <items id="description">A time with a range.</items>
          <items id="text">Time in a range</items>
        </term_definitions>
        <term_definitions code="at0011">
          <items id="description">A duration whose range excludes zero.</items>
          <items id="text">Duration in a range</items>
        </term_definitions>
        <term_definitions code="at0012">
          <items id="description">A duration whose pattern admits weeks only.</items>
          <items id="text">Duration in weeks</items>
        </term_definitions>
        <term_definitions code="at0013">
          <items id="description">Interval bounds, one side left without units.</items>
          <items id="text">Pressure interval, one side in units</items>
        </term_definitions>
        <term_definitions code="at0014">
          <items id="description">Interval bounds whose unit lists share one unit.</items>
          <items id="text">Pressure interval, shared unit</items>
        </term_definitions>
        <term_definitions code="at0015">
          <items id="description">SNOMED-CT codes with terms defined under the bare code.</items>
          <items id="text">Coded under the bare code</items>
        </term_definitions>
        <term_definitions code="at0016">
          <items id="description">An element whose coded name a C_STRING pins.</items>
          <items id="text">Coded name</items>
        </term_definitions>
        <term_definitions code="at0017">
          <items id="description">The first code of the name.</items>
          <items id="text">First option</items>
        </term_definitions>
        <term_definitions code="at0018">
          <items id="description">The second code of the name.</items>
          <items id="text">Second option</items>
        </term_definitions>
