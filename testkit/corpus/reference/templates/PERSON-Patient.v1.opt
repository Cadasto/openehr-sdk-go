        <archetype_id>
          <value>openEHR-DEMOGRAPHIC-PARTY_RELATIONSHIP.care_relationship.v1</value>
        </archetype_id>
        <term_definitions code="at0000">
          <items id="text">Care relationship</items>
          <items id="description">The source party, usually a patient, is in the care of the target party: a care provider, a care team or an organisation.</items>
        </term_definitions>
        <term_definitions code="at0001">
          <items id="text">Details</items>
          <items id="description">Data about the relationship.</items>
        </term_definitions>
        <term_definitions code="at0002">
          <items id="text">Care relationship type</items>
          <items id="description">The part the target plays in the source party's care.</items>
        </term_definitions>
        <term_definitions code="at0003">
          <items id="text">Primary care provider</items>
          <items id="description">The target is the source party's primary care provider, such as a general practitioner. Corresponds to FHIR Patient.generalPractitioner.</items>
        </term_definitions>
        <term_definitions code="at0004">
          <items id="text">Responsible care provider</items>
          <items id="description">The target is responsible for the source party's care.</items>
        </term_definitions>
        <term_definitions code="at0005">
          <items id="text">Care team</items>
          <items id="description">The target is a care team that cares for the source party. Corresponds to FHIR CareTeam.subject.</items>
        </term_definitions>
        <term_definitions code="at0006">
          <items id="text">Case manager</items>
          <items id="description">The target coordinates the source party's care across providers.</items>
        </term_definitions>
        <term_definitions code="at0007">
          <items id="text">Managing organisation</items>
          <items id="description">The target is the organisation that manages the source party's care and record. Corresponds to FHIR Patient.managingOrganization.</items>
        </term_definitions>
        <term_definitions code="at0008">
          <items id="text">Reason</items>
          <items id="description">Why the care relationship exists, such as the condition or the referral it follows.</items>
        </term_definitions>
        <term_definitions code="at0009">
          <items id="text">Comment</items>
          <items id="description">A note about the relationship.</items>
        </term_definitions>
      </children>
