        <archetype_id>
          <value>openEHR-DEMOGRAPHIC-PARTY_RELATIONSHIP.role_assignment.v1</value>
        </archetype_id>
        <term_definitions code="at0000">
          <items id="text">Role assignment</items>
          <items id="description">The source actor holds the target role.</items>
        </term_definitions>
        <term_definitions code="at0001">
          <items id="text">Details</items>
          <items id="description">Data about the relationship.</items>
        </term_definitions>
        <term_definitions code="at0002">
          <items id="text">Specialty</items>
          <items id="description">The specialty in which the actor holds the role.</items>
          <items id="comment">Corresponds to FHIR PractitionerRole.specialty.</items>
        </term_definitions>
        <term_definitions code="at0003">
          <items id="text">Comment</items>
          <items id="description">A note about the assignment.</items>
        </term_definitions>
      </children>
