    <archetype_id>
      <value>openEHR-DEMOGRAPHIC-PERSON.generic_person.v1</value>
    </archetype_id>
    <term_definitions code="at0000">
      <items id="text">Person</items>
      <items id="description">A human being recorded as a party in a demographic service, independent of any role the person plays.</items>
    </term_definitions>
    <term_definitions code="at0001">
      <items id="text">Details</items>
      <items id="description">Data about the person other than names and contacts.</items>
    </term_definitions>
    <term_definitions code="at0002">
      <items id="text">Identifier</items>
      <items id="description">An identifier issued for the person, such as a patient number, a pseudonym, a national person number, a passport number or a professional registration number.</items>
      <items id="comment">Record the kind of identifier in type (for example a code of HL7 v2 table 0203: MR, PI, ANON, NI, PPN, DL, PRN, NPI, LN), the authority whose scheme it belongs to in issuer, and the organisation that assigned it in assigner. Corresponds to FHIR Patient.identifier and Practitioner.identifier.</items>
    </term_definitions>
    <term_definitions code="at0003">
      <items id="text">Date of birth</items>
      <items id="description">The date on which the person was born.</items>
      <items id="comment">A partial date, such as the year alone, may be recorded. Corresponds to FHIR birthDate.</items>
    </term_definitions>
    <term_definitions code="at0004">
      <items id="text">Administrative gender</items>
      <items id="description">The gender of the person used for administrative purposes.</items>
      <items id="comment">The four codes match FHIR AdministrativeGender one to one. It is not an observation of sex or of gender identity; those belong in the health record.</items>
    </term_definitions>
    <term_definitions code="at0005">
      <items id="text">Male</items>
      <items id="description">Male. FHIR AdministrativeGender code male.</items>
    </term_definitions>
    <term_definitions code="at0006">
      <items id="text">Female</items>
      <items id="description">Female. FHIR AdministrativeGender code female.</items>
    </term_definitions>
    <term_definitions code="at0007">
      <items id="text">Other</items>
      <items id="description">Other than male or female. FHIR AdministrativeGender code other.</items>
    </term_definitions>
    <term_definitions code="at0008">
      <items id="text">Unknown</items>
      <items id="description">The gender is not known. FHIR AdministrativeGender code unknown.</items>
    </term_definitions>
    <term_definitions code="at0009">
      <items id="text">Deceased</items>
      <items id="description">Whether the person is known to have died.</items>
      <items id="comment">Corresponds to FHIR deceasedBoolean.</items>
    </term_definitions>
    <term_definitions code="at0010">
      <items id="text">Date and time of death</items>
      <items id="description">When the person died, as precisely as it is known.</items>
      <items id="comment">Corresponds to FHIR deceasedDateTime.</items>
    </term_definitions>
    <term_definitions code="at0011">
      <items id="text">Marital status</items>
      <items id="description">The person's marital or civil status.</items>
      <items id="comment">The codes are those of the FHIR R4 marital-status value set. Corresponds to FHIR Patient.maritalStatus.</items>
    </term_definitions>
    <term_definitions code="at0012">
      <items id="text">Annulled</items>
      <items id="description">The marriage was declared never to have existed. HL7 v3 MaritalStatus code A.</items>
    </term_definitions>
    <term_definitions code="at0013">
      <items id="text">Divorced</items>
      <items id="description">The marriage was dissolved. HL7 v3 MaritalStatus code D.</items>
    </term_definitions>
    <term_definitions code="at0014">
      <items id="text">Interlocutory</items>
      <items id="description">A divorce is subject to a final decree. HL7 v3 MaritalStatus code I.</items>
    </term_definitions>
    <term_definitions code="at0015">
      <items id="text">Legally separated</items>
      <items id="description">Legally separated. HL7 v3 MaritalStatus code L.</items>
    </term_definitions>
    <term_definitions code="at0016">
      <items id="text">Married</items>
      <items id="description">A current marriage contract is active. HL7 v3 MaritalStatus code M.</items>
    </term_definitions>
    <term_definitions code="at0017">
      <items id="text">Polygamous</items>
      <items id="description">More than one current spouse. HL7 v3 MaritalStatus code P.</items>
    </term_definitions>
    <term_definitions code="at0018">
      <items id="text">Never married</items>
      <items id="description">No marriage contract has ever been entered. HL7 v3 MaritalStatus code S.</items>
    </term_definitions>
    <term_definitions code="at0019">
      <items id="text">Domestic partner</items>
      <items id="description">A person declares that a domestic partner relationship exists. HL7 v3 MaritalStatus code T.</items>
    </term_definitions>
    <term_definitions code="at0020">
      <items id="text">Unmarried</items>
      <items id="description">Currently not in a marriage contract. HL7 v3 MaritalStatus code U.</items>
    </term_definitions>
    <term_definitions code="at0021">
      <items id="text">Widowed</items>
      <items id="description">The spouse has died. HL7 v3 MaritalStatus code W.</items>
    </term_definitions>
    <term_definitions code="at0022">
      <items id="text">Multiple birth</items>
      <items id="description">Whether the person was born as part of a multiple birth, or the person's position in the birth order.</items>
      <items id="comment">Record a Boolean, or a count for the birth order. Corresponds to FHIR multipleBirth[x].</items>
    </term_definitions>
    <term_definitions code="at0023">
      <items id="text">Place of birth</items>
      <items id="description">The place where the person was born.</items>
      <items id="comment">Corresponds to the FHIR patient-birthPlace extension.</items>
    </term_definitions>
    <term_definitions code="at0024">
      <items id="text">Qualification</items>
      <items id="description">A qualification, licence or certification the person holds, such as a professional registration or an academic degree.</items>
      <items id="comment">Corresponds to FHIR Practitioner.qualification.</items>
    </term_definitions>
    <term_definitions code="at0025">
      <items id="text">Qualification</items>
      <items id="description">The name or code of the qualification.</items>
      <items id="comment">Coding is preferred, for example with HL7 v2 table 0360 or a national register's codes.</items>
    </term_definitions>
    <term_definitions code="at0026">
      <items id="text">Qualification identifier</items>
      <items id="description">An identifier of the qualification, such as a registration number.</items>
    </term_definitions>
    <term_definitions code="at0027">
      <items id="text">Issuer</items>
      <items id="description">The organisation that issued the qualification.</items>
    </term_definitions>
    <term_definitions code="at0028">
      <items id="text">Period of validity</items>
      <items id="description">The period in which the qualification is valid.</items>
    </term_definitions>
    <term_definitions code="at0029">
      <items id="text">Contact person</items>
      <items id="description">A person to contact about this person, such as next of kin or an emergency contact.</items>
      <items id="comment">Record how the contact relates to this person in the cluster's Role element, for example with HL7 v2 table 0131 (C emergency contact, N next of kin). Corresponds to FHIR Patient.contact.</items>
    </term_definitions>
    <term_definitions code="at0030">
      <items id="text">Additional details</items>
      <items id="description">Further details about the person that a particular use needs.</items>
    </term_definitions>
    <term_definitions code="at0031">
      <items id="text">Person name</items>
      <items id="description">A name by which the person is known.</items>
      <items id="comment">The name of the PARTY_IDENTITY is its purpose: the use of the name. The codes match FHIR NameUse.</items>
    </term_definitions>
    <term_definitions code="at0032">
      <items id="text">Usual</items>
      <items id="description">The name the person is usually known by. FHIR NameUse code usual.</items>
    </term_definitions>
    <term_definitions code="at0033">
      <items id="text">Official</items>
      <items id="description">The name registered officially, such as on a birth certificate or passport. FHIR NameUse code official.</items>
    </term_definitions>
    <term_definitions code="at0034">
      <items id="text">Temporary</items>
      <items id="description">A name used for a limited period. FHIR NameUse code temp.</items>
    </term_definitions>
    <term_definitions code="at0035">
      <items id="text">Nickname</items>
      <items id="description">An informal name the person uses. FHIR NameUse code nickname.</items>
    </term_definitions>
    <term_definitions code="at0036">
      <items id="text">Anonymous</items>
      <items id="description">A name used to keep the person anonymous. FHIR NameUse code anonymous.</items>
    </term_definitions>
    <term_definitions code="at0037">
      <items id="text">Old</items>
      <items id="description">A name no longer in use. FHIR NameUse code old.</items>
    </term_definitions>
    <term_definitions code="at0038">
      <items id="text">Maiden</items>
      <items id="description">A name used before marriage. FHIR NameUse code maiden.</items>
    </term_definitions>
    <term_definitions code="at0039">
      <items id="text">Name details</items>
      <items id="description">The name and its parts.</items>
    </term_definitions>
    <term_definitions code="at0040">
      <items id="text">Full name</items>
      <items id="description">The whole name, as it is displayed.</items>
      <items id="comment">Corresponds to FHIR HumanName.text.</items>
    </term_definitions>
    <term_definitions code="at0041">
      <items id="text">Structured name</items>
      <items id="description">The name in its parts.</items>
    </term_definitions>
    <term_definitions code="at0042">
      <items id="text">Period of use</items>
      <items id="description">The period in which the name was or is in use.</items>
      <items id="comment">Corresponds to FHIR HumanName.period.</items>
    </term_definitions>
    <term_definitions code="at0043">
      <items id="text">Pseudonym</items>
      <items id="description">A designation by which the person is known in place of a name.</items>
      <items id="comment">For a person whose name is held elsewhere, for example where the identity is kept apart from the health record.</items>
    </term_definitions>
    <term_definitions code="at0044">
      <items id="text">Pseudonym details</items>
      <items id="description">The pseudonym.</items>
    </term_definitions>
    <term_definitions code="at0045">
      <items id="text">Pseudonym</items>
      <items id="description">A designation that does not by itself identify the person, such as a patient number or a randomly assigned label.</items>
    </term_definitions>
    <term_definitions code="at0046">
      <items id="text">Contact</items>
      <items id="description">A group of addresses at which the person can be reached for one purpose, with the period in which they are valid.</items>
      <items id="comment">The name of the CONTACT is its purpose. The codes match FHIR AddressUse and ContactPointUse; the CONTACT's time_validity is the period of use.</items>
    </term_definitions>
    <term_definitions code="at0047">
      <items id="text">Home</items>
      <items id="description">The addresses of the party's home. Corresponds to FHIR use home.</items>
    </term_definitions>
    <term_definitions code="at0048">
      <items id="text">Work</items>
      <items id="description">The addresses at which the party works. Corresponds to FHIR use work.</items>
    </term_definitions>
    <term_definitions code="at0049">
      <items id="text">Temporary</items>
      <items id="description">Addresses in use for a limited period. Corresponds to FHIR use temp.</items>
    </term_definitions>
    <term_definitions code="at0050">
      <items id="text">Old</items>
      <items id="description">Addresses that are no longer in use. Corresponds to FHIR use old.</items>
    </term_definitions>
    <term_definitions code="at0051">
      <items id="text">Billing</items>
      <items id="description">Addresses for invoices and payment. Corresponds to FHIR AddressUse billing.</items>
    </term_definitions>
    <term_definitions code="at0052">
      <items id="text">Postal address</items>
      <items id="description">A physical or postal address.</items>
    </term_definitions>
    <term_definitions code="at0053">
      <items id="text">Postal address details</items>
      <items id="description">The structure that holds the address.</items>
    </term_definitions>
