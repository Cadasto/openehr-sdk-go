    <archetype_id>
      <value>openEHR-DEMOGRAPHIC-GROUP.care_team.v1</value>
    </archetype_id>
    <term_definitions code="at0000">
      <items id="text">Care team</items>
      <items id="description">A group of care providers, and possibly others, who plan and coordinate the care of one or more patients.</items>
    </term_definitions>
    <term_definitions code="at0001">
      <items id="text">Details</items>
      <items id="description">Data about the care team.</items>
    </term_definitions>
    <term_definitions code="at0002">
      <items id="text">Identifier</items>
      <items id="description">An identifier of the care team.</items>
      <items id="comment">Corresponds to FHIR CareTeam.identifier.</items>
    </term_definitions>
    <term_definitions code="at0003">
      <items id="text">Status</items>
      <items id="description">The state of the care team.</items>
      <items id="comment">The codes match FHIR R4 CareTeamStatus.</items>
    </term_definitions>
    <term_definitions code="at0004">
      <items id="text">Proposed</items>
      <items id="description">The team is planned but not yet active. FHIR CareTeamStatus code proposed.</items>
    </term_definitions>
    <term_definitions code="at0005">
      <items id="text">Active</items>
      <items id="description">The team is active. FHIR CareTeamStatus code active.</items>
    </term_definitions>
    <term_definitions code="at0006">
      <items id="text">Suspended</items>
      <items id="description">The team is paused. FHIR CareTeamStatus code suspended.</items>
    </term_definitions>
    <term_definitions code="at0007">
      <items id="text">Inactive</items>
      <items id="description">The team no longer acts. FHIR CareTeamStatus code inactive.</items>
    </term_definitions>
    <term_definitions code="at0008">
      <items id="text">Entered in error</items>
      <items id="description">The team was recorded in error. FHIR CareTeamStatus code entered-in-error.</items>
    </term_definitions>
    <term_definitions code="at0009">
      <items id="text">Category</items>
      <items id="description">The kind of care team.</items>
      <items id="comment">The codes are those of the FHIR R4 care-team-category value set, bound to LOINC.</items>
    </term_definitions>
    <term_definitions code="at0010">
      <items id="text">Event-focused care team</items>
      <items id="description">A team for one event, such as a procedure.</items>
    </term_definitions>
    <term_definitions code="at0011">
      <items id="text">Encounter-focused care team</items>
      <items id="description">A team for one encounter.</items>
    </term_definitions>
    <term_definitions code="at0012">
      <items id="text">Episode of care-focused care team</items>
      <items id="description">A team for an episode of care.</items>
    </term_definitions>
    <term_definitions code="at0013">
      <items id="text">Condition-focused care team</items>
      <items id="description">A team for a condition, such as a chronic disease.</items>
    </term_definitions>
    <term_definitions code="at0014">
      <items id="text">Longitudinal care-coordination focused care team</items>
      <items id="description">A team that coordinates care over time.</items>
    </term_definitions>
    <term_definitions code="at0015">
      <items id="text">Home and community based services (HCBS)-focused care team</items>
      <items id="description">A team for home and community based services.</items>
    </term_definitions>
    <term_definitions code="at0016">
      <items id="text">Clinical research-focused care team</items>
      <items id="description">A team for a clinical research study.</items>
    </term_definitions>
    <term_definitions code="at0017">
      <items id="text">Public health-focused care team</items>
      <items id="description">A team for a public health purpose.</items>
    </term_definitions>
    <term_definitions code="at0018">
      <items id="text">Period</items>
      <items id="description">The period in which the team is or was active.</items>
      <items id="comment">Corresponds to FHIR CareTeam.period.</items>
    </term_definitions>
    <term_definitions code="at0019">
      <items id="text">Reason</items>
      <items id="description">Why the team exists, such as the condition it addresses.</items>
      <items id="comment">Corresponds to FHIR CareTeam.reasonCode.</items>
    </term_definitions>
    <term_definitions code="at0020">
      <items id="text">Comment</items>
      <items id="description">A note about the team.</items>
      <items id="comment">Corresponds to FHIR CareTeam.note.</items>
    </term_definitions>
    <term_definitions code="at0021">
      <items id="text">Additional details</items>
      <items id="description">Further details about the team that a particular use needs.</items>
    </term_definitions>
    <term_definitions code="at0022">
      <items id="text">Team name</items>
      <items id="description">The name by which the team is known.</items>
    </term_definitions>
    <term_definitions code="at0023">
      <items id="text">Name details</items>
      <items id="description">The name.</items>
    </term_definitions>
    <term_definitions code="at0024">
      <items id="text">Name</items>
      <items id="description">The name of the team, as it is displayed.</items>
    </term_definitions>
    <term_definitions code="at0025">
      <items id="text">Contact</items>
      <items id="description">A group of addresses at which the party can be reached for one purpose, with the period in which they are valid.</items>
    </term_definitions>
    <term_definitions code="at0026">
      <items id="text">Electronic communication</items>
      <items id="description">An electronic address, such as a telephone number, an email address or a URL.</items>
    </term_definitions>
    <term_definitions code="at0027">
      <items id="text">Electronic communication details</items>
      <items id="description">The structure that holds the electronic address.</items>
    </term_definitions>
    <term_definitions code="at0028">
      <items id="text">Electronic communication</items>
      <items id="description">The electronic address.</items>
    </term_definitions>
    <term_definitions code="at0029">
      <items id="text">Relationship</items>
      <items id="description">The team's membership of an organisation, such as the organisation that manages it.</items>
      <items id="comment">Corresponds to FHIR CareTeam.managingOrganization. Members are not listed here: a member records its membership of the team as a relationship of its own.</items>
    </term_definitions>
    <term_bindings terminology="LOINC">
      <items code="at0010">
