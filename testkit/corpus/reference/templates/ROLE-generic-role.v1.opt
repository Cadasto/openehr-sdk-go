    <archetype_id>
      <value>openEHR-DEMOGRAPHIC-ROLE.generic_role.v1</value>
    </archetype_id>
    <term_definitions code="at0000">
      <items id="text">Role</items>
      <items id="description">A function that actors perform, such as care provider, patient or administrator, with the capabilities that come with it.</items>
    </term_definitions>
    <term_definitions code="at0001">
      <items id="text">Details</items>
      <items id="description">Data about the role.</items>
    </term_definitions>
    <term_definitions code="at0002">
      <items id="text">Role code</items>
      <items id="description">A code or name for the function.</items>
      <items id="comment">Coding is preferred, for example with the FHIR practitioner-role codes, a SNOMED CT occupation or a local code. Corresponds to FHIR PractitionerRole.code.</items>
    </term_definitions>
    <term_definitions code="at0003">
      <items id="text">Specialty</items>
      <items id="description">A specialty within the function.</items>
      <items id="comment">Corresponds to FHIR PractitionerRole.specialty.</items>
    </term_definitions>
    <term_definitions code="at0004">
      <items id="text">Description</items>
      <items id="description">A description of the function.</items>
    </term_definitions>
    <term_definitions code="at0005">
      <items id="text">Identifier</items>
      <items id="description">An identifier of the role, such as its code in another system.</items>
    </term_definitions>
    <term_definitions code="at0006">
      <items id="text">Active</items>
      <items id="description">Whether the role is in use.</items>
      <items id="comment">Corresponds to FHIR PractitionerRole.active. The period of validity is the ROLE's time_validity.</items>
    </term_definitions>
    <term_definitions code="at0007">
      <items id="text">Additional details</items>
      <items id="description">Further details about the role that a particular use needs.</items>
    </term_definitions>
    <term_definitions code="at0008">
      <items id="text">Role name</items>
      <items id="description">The name by which the role is known.</items>
    </term_definitions>
    <term_definitions code="at0009">
      <items id="text">Name details</items>
      <items id="description">The name.</items>
    </term_definitions>
    <term_definitions code="at0010">
      <items id="text">Name</items>
      <items id="description">The name of the role, as it is displayed.</items>
    </term_definitions>
    <term_definitions code="at0011">
      <items id="text">Capability</items>
      <items id="description">Something an actor in the role is permitted or able to do.</items>
      <items id="comment">The name of the CAPABILITY is the capability. Its time_validity is the period in which it holds.</items>
    </term_definitions>
    <term_definitions code="at0012">
      <items id="text">Credentials</items>
      <items id="description">What the capability grants and requires.</items>
    </term_definitions>
    <term_definitions code="at0013">
      <items id="text">Permission</items>
      <items id="description">A permission the capability grants, such as an access scope.</items>
      <items id="comment">For example a SMART on openEHR scope, or a local permission code.</items>
    </term_definitions>
    <term_definitions code="at0014">
      <items id="text">Required qualification</items>
      <items id="description">A qualification an actor needs to exercise the capability.</items>
    </term_definitions>
    <term_definitions code="at0015">
      <items id="text">Description</items>
      <items id="description">A description of the capability.</items>
    </term_definitions>
    <term_definitions code="at0016">
      <items id="text">Contact</items>
      <items id="description">A group of addresses at which the party can be reached for one purpose, with the period in which they are valid.</items>
    </term_definitions>
    <term_definitions code="at0017">
      <items id="text">Electronic communication</items>
      <items id="description">An electronic address, such as a telephone number, an email address or a URL.</items>
    </term_definitions>
    <term_definitions code="at0018">
      <items id="text">Electronic communication details</items>
      <items id="description">The structure that holds the electronic address.</items>
    </term_definitions>
    <term_definitions code="at0019">
      <items id="text">Electronic communication</items>
      <items id="description">The electronic address.</items>
    </term_definitions>
  </definition>
</template>
