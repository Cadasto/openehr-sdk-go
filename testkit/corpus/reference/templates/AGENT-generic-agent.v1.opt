    <archetype_id>
      <value>openEHR-DEMOGRAPHIC-AGENT.generic_agent.v1</value>
    </archetype_id>
    <term_definitions code="at0000">
      <items id="text">Agent</items>
      <items id="description">A non-human actor, such as a software application, a device or a service, that takes part in care or in the exchange of records.</items>
    </term_definitions>
    <term_definitions code="at0001">
      <items id="text">Details</items>
      <items id="description">Data about the agent.</items>
    </term_definitions>
    <term_definitions code="at0002">
      <items id="text">Identifier</items>
      <items id="description">An identifier of the agent, such as a client id, a serial number or a unique device identifier.</items>
      <items id="comment">Corresponds to FHIR Device.identifier.</items>
    </term_definitions>
    <term_definitions code="at0003">
      <items id="text">Agent type</items>
      <items id="description">The kind of agent.</items>
      <items id="comment">Corresponds to FHIR Device.type.</items>
    </term_definitions>
    <term_definitions code="at0004">
      <items id="text">Software application</items>
      <items id="description">A program that acts, such as a clinical application or an integration engine.</items>
    </term_definitions>
    <term_definitions code="at0005">
      <items id="text">Device</items>
      <items id="description">A physical device, such as a medical device or a monitor.</items>
    </term_definitions>
    <term_definitions code="at0006">
      <items id="text">Service</items>
      <items id="description">A service that acts on its own, such as a scheduled job or a remote system.</items>
    </term_definitions>
    <term_definitions code="at0007">
      <items id="text">Description</items>
      <items id="description">A description of the agent.</items>
    </term_definitions>
    <term_definitions code="at0008">
      <items id="text">Manufacturer</items>
      <items id="description">The organisation that makes or publishes the agent.</items>
      <items id="comment">Corresponds to FHIR Device.manufacturer.</items>
    </term_definitions>
    <term_definitions code="at0009">
      <items id="text">Model</items>
      <items id="description">The model or product name.</items>
      <items id="comment">Corresponds to FHIR Device.modelNumber.</items>
    </term_definitions>
    <term_definitions code="at0010">
      <items id="text">Version</items>
      <items id="description">A version of the agent or of one of its components.</items>
      <items id="comment">Corresponds to FHIR Device.version.</items>
    </term_definitions>
    <term_definitions code="at0011">
      <items id="text">Status</items>
      <items id="description">Whether the agent is in use.</items>
      <items id="comment">The codes match FHIR R4 FHIRDeviceStatus.</items>
    </term_definitions>
    <term_definitions code="at0012">
      <items id="text">Active</items>
      <items id="description">The agent is in use. FHIR FHIRDeviceStatus code active.</items>
    </term_definitions>
    <term_definitions code="at0013">
      <items id="text">Inactive</items>
      <items id="description">The agent is not in use. FHIR FHIRDeviceStatus code inactive.</items>
    </term_definitions>
    <term_definitions code="at0014">
      <items id="text">Entered in error</items>
      <items id="description">The agent was recorded in error. FHIR FHIRDeviceStatus code entered-in-error.</items>
    </term_definitions>
    <term_definitions code="at0015">
      <items id="text">Unknown</items>
      <items id="description">It is not known whether the agent is in use. FHIR FHIRDeviceStatus code unknown.</items>
    </term_definitions>
    <term_definitions code="at0016">
      <items id="text">Device details</items>
      <items id="description">Details of the medical device, when the agent is one.</items>
    </term_definitions>
    <term_definitions code="at0017">
      <items id="text">Additional details</items>
      <items id="description">Further details about the agent that a particular use needs.</items>
    </term_definitions>
    <term_definitions code="at0018">
      <items id="text">Agent name</items>
      <items id="description">A name by which the agent is known.</items>
      <items id="comment">The name of the PARTY_IDENTITY is the kind of name. The codes match FHIR R4 DeviceNameType.</items>
    </term_definitions>
    <term_definitions code="at0019">
      <items id="text">User-friendly name</items>
      <items id="description">The name users know the agent by. FHIR DeviceNameType code user-friendly-name.</items>
    </term_definitions>
    <term_definitions code="at0020">
      <items id="text">Manufacturer name</items>
      <items id="description">The name the manufacturer gives the agent. FHIR DeviceNameType code manufacturer-name.</items>
    </term_definitions>
    <term_definitions code="at0021">
      <items id="text">Model name</items>
      <items id="description">The name of the model. FHIR DeviceNameType code model-name.</items>
    </term_definitions>
    <term_definitions code="at0022">
      <items id="text">Other</items>
      <items id="description">Another kind of name. FHIR DeviceNameType code other.</items>
    </term_definitions>
    <term_definitions code="at0023">
      <items id="text">Name details</items>
      <items id="description">The name.</items>
    </term_definitions>
    <term_definitions code="at0024">
      <items id="text">Name</items>
      <items id="description">The name of the agent, as it is displayed.</items>
    </term_definitions>
    <term_definitions code="at0025">
      <items id="text">Contact</items>
      <items id="description">A group of addresses at which the party can be reached for one purpose, with the period in which they are valid.</items>
    </term_definitions>
    <term_definitions code="at0026">
      <items id="text">Electronic communication</items>
      <items id="description">An electronic address, such as a telephone number, an email address or a URL.</items>
    </term_definitions>
    <term_definitions code="at0027">
      <items id="text">Electronic communication details</items>
      <items id="description">The structure that holds the electronic address.</items>
    </term_definitions>
    <term_definitions code="at0028">
      <items id="text">Electronic communication</items>
      <items id="description">The electronic address.</items>
    </term_definitions>
    <term_definitions code="at0029">
      <items id="text">Relationship</items>
      <items id="description">A relationship the agent holds to another party.</items>
    </term_definitions>
  </definition>
</template>
