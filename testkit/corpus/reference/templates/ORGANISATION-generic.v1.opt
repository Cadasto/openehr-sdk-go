    <archetype_id>
      <value>openEHR-DEMOGRAPHIC-ORGANISATION.generic_organisation.v1</value>
    </archetype_id>
    <term_definitions code="at0000">
      <items id="text">Organisation</items>
      <items id="description">An organisation with a legal or administrative standing, such as a hospital, a practice, a department of either, an insurer or a public body.</items>
    </term_definitions>
    <term_definitions code="at0001">
      <items id="text">Details</items>
      <items id="description">Data about the organisation other than names and contacts.</items>
    </term_definitions>
    <term_definitions code="at0002">
      <items id="text">Identifier</items>
      <items id="description">An identifier issued for the organisation, such as a national provider register number, a chamber of commerce number or a tax number.</items>
      <items id="comment">Record the kind of identifier in type (for example HL7 v2 table 0203 code XX, organisation identifier), the authority whose scheme it belongs to in issuer, and the organisation that assigned it in assigner. Corresponds to FHIR Organization.identifier.</items>
    </term_definitions>
    <term_definitions code="at0003">
      <items id="text">Organisation type</items>
      <items id="description">The kind of organisation.</items>
      <items id="comment">The codes match the FHIR R4 organization-type value set. Corresponds to FHIR Organization.type.</items>
    </term_definitions>
    <term_definitions code="at0004">
      <items id="text">Healthcare provider</items>
      <items id="description">An organisation that provides healthcare services. FHIR organization-type code prov.</items>
    </term_definitions>
    <term_definitions code="at0005">
      <items id="text">Hospital department</items>
      <items id="description">A department or ward within a hospital. FHIR organization-type code dept.</items>
    </term_definitions>
    <term_definitions code="at0006">
      <items id="text">Organisational team</items>
      <items id="description">A team of practitioners that performs a specific function within an organisation. FHIR organization-type code team.</items>
    </term_definitions>
    <term_definitions code="at0007">
      <items id="text">Government</items>
      <items id="description">A political body, such as a national, a regional or a local government. FHIR organization-type code govt.</items>
    </term_definitions>
    <term_definitions code="at0008">
      <items id="text">Insurance company</items>
      <items id="description">A company that provides insurance, which may include healthcare. FHIR organization-type code ins.</items>
    </term_definitions>
    <term_definitions code="at0009">
      <items id="text">Payer</items>
      <items id="description">An organisation that processes claims or pays providers on behalf of patients. FHIR organization-type code pay.</items>
    </term_definitions>
    <term_definitions code="at0010">
      <items id="text">Educational institute</items>
      <items id="description">An institution that provides education or research facilities. FHIR organization-type code edu.</items>
    </term_definitions>
    <term_definitions code="at0011">
      <items id="text">Religious institution</items>
      <items id="description">An organisation that is part of a religious institution. FHIR organization-type code reli.</items>
    </term_definitions>
    <term_definitions code="at0012">
      <items id="text">Clinical research sponsor</items>
      <items id="description">A pharmaceutical or clinical research sponsor. FHIR organization-type code crs.</items>
    </term_definitions>
    <term_definitions code="at0013">
      <items id="text">Community group</items>
      <items id="description">An unincorporated community group. FHIR organization-type code cg.</items>
    </term_definitions>
    <term_definitions code="at0014">
      <items id="text">Non-healthcare business or corporation</items>
      <items id="description">A registered business or corporation not of another type. FHIR organization-type code bus.</items>
    </term_definitions>
    <term_definitions code="at0015">
      <items id="text">Other</items>
      <items id="description">Another kind of organisation. FHIR organization-type code other.</items>
    </term_definitions>
    <term_definitions code="at0016">
      <items id="text">Active</items>
      <items id="description">Whether the organisation's record is in use.</items>
      <items id="comment">Corresponds to FHIR Organization.active.</items>
    </term_definitions>
    <term_definitions code="at0017">
      <items id="text">Description</items>
      <items id="description">A description of the organisation and what it does.</items>
    </term_definitions>
    <term_definitions code="at0018">
      <items id="text">Contact person</items>
      <items id="description">A person to contact at the organisation, such as for billing or for administration.</items>
      <items id="comment">Record the purpose of the contact in the cluster's Role element, for example with the FHIR contactentity-type codes (BILL, ADMIN, HR, PAYOR, PATINF, PRESS). Corresponds to FHIR Organization.contact.</items>
    </term_definitions>
    <term_definitions code="at0019">
      <items id="text">Additional details</items>
      <items id="description">Further details about the organisation that a particular use needs.</items>
    </term_definitions>
    <term_definitions code="at0020">
      <items id="text">Organisation name</items>
      <items id="description">A name by which the organisation is known.</items>
      <items id="comment">The name of the PARTY_IDENTITY is the kind of name. The kinds are those of the CKM draft openEHR-DEMOGRAPHIC-PARTY_IDENTITY.organisation_name.v0, from ISO/DTS 27527 provider identification.</items>
    </term_definitions>
    <term_definitions code="at0021">
      <items id="text">Enterprise name</items>
      <items id="description">The complete name of the organisation, usually the same as its registered name. Corresponds to FHIR Organization.name.</items>
    </term_definitions>
    <term_definitions code="at0022">
      <items id="text">Business name</items>
      <items id="description">A name used for trading. Corresponds to FHIR Organization.alias.</items>
    </term_definitions>
    <term_definitions code="at0023">
      <items id="text">Locally used name</items>
      <items id="description">A name the organisation is known by locally, other than its registered or business name. Corresponds to FHIR Organization.alias.</items>
    </term_definitions>
    <term_definitions code="at0024">
      <items id="text">Abbreviated name</items>
      <items id="description">A short or abbreviated name. Corresponds to FHIR Organization.alias.</items>
    </term_definitions>
    <term_definitions code="at0025">
      <items id="text">Organisational unit/section/division name</items>
      <items id="description">The name of a unit, a section or a division that has an identity of its own within the organisation.</items>
    </term_definitions>
    <term_definitions code="at0026">
      <items id="text">Service location name</items>
      <items id="description">A name of which the location of a service is an important part, such as a mobile unit at a named site.</items>
    </term_definitions>
    <term_definitions code="at0027">
      <items id="text">Other</items>
      <items id="description">A name that is none of the kinds above.</items>
    </term_definitions>
    <term_definitions code="at0028">
      <items id="text">Unknown</items>
      <items id="description">A name of an unknown kind.</items>
    </term_definitions>
    <term_definitions code="at0029">
      <items id="text">Name details</items>
      <items id="description">The name.</items>
    </term_definitions>
    <term_definitions code="at0030">
      <items id="text">Name</items>
      <items id="description">The name of the organisation, as it is displayed.</items>
    </term_definitions>
    <term_definitions code="at0031">
      <items id="text">Contact</items>
      <items id="description">A group of addresses at which the organisation can be reached for one purpose, with the period in which they are valid.</items>
      <items id="comment">The name of the CONTACT is its purpose. The codes match FHIR AddressUse and ContactPointUse, without home, which FHIR does not allow for an organisation; the CONTACT's time_validity is the period of use. Corresponds to FHIR Organization.address and Organization.telecom.</items>
    </term_definitions>
    <term_definitions code="at0032">
      <items id="text">Work</items>
      <items id="description">The addresses at which the organisation works and can be reached. Corresponds to FHIR use work.</items>
    </term_definitions>
    <term_definitions code="at0033">
      <items id="text">Temporary</items>
      <items id="description">Addresses in use for a limited period. Corresponds to FHIR use temp.</items>
    </term_definitions>
    <term_definitions code="at0034">
      <items id="text">Old</items>
      <items id="description">Addresses that are no longer in use. Corresponds to FHIR use old.</items>
    </term_definitions>
    <term_definitions code="at0035">
      <items id="text">Billing</items>
      <items id="description">Addresses for invoices and payment. Corresponds to FHIR AddressUse billing.</items>
    </term_definitions>
    <term_definitions code="at0036">
      <items id="text">Postal address</items>
      <items id="description">A physical or postal address.</items>
    </term_definitions>
    <term_definitions code="at0037">
      <items id="text">Postal address details</items>
      <items id="description">The structure that holds the address.</items>
    </term_definitions>
    <term_definitions code="at0038">
      <items id="text">Address</items>
      <items id="description">The address.</items>
    </term_definitions>
    <term_definitions code="at0039">
      <items id="text">Electronic communication</items>
      <items id="description">An electronic address, such as a telephone number or an email address.</items>
    </term_definitions>
    <term_definitions code="at0040">
      <items id="text">Electronic communication details</items>
      <items id="description">The structure that holds the electronic address.</items>
    </term_definitions>
    <term_definitions code="at0041">
      <items id="text">Electronic communication</items>
      <items id="description">The electronic address.</items>
    </term_definitions>
    <term_definitions code="at0042">
      <items id="text">Relationship</items>
      <items id="description">A relationship the organisation holds to another party, such as the organisation it is part of.</items>
      <items id="comment">An organisation records the organisation it is part of, not its parts: a department holds its relationship to its hospital.</items>
    </term_definitions>
  </definition>
</template>
