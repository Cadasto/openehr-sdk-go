        <archetype_id>
          <value>openEHR-DEMOGRAPHIC-PARTY_RELATIONSHIP.party_membership.v1</value>
        </archetype_id>
        <term_definitions code="at0000">
          <items id="text">Membership</items>
          <items id="description">The source party is a member of the target party: a group, such as a care team, or an organisation.</items>
        </term_definitions>
        <term_definitions code="at0001">
          <items id="text">Details</items>
          <items id="description">Data about the relationship.</items>
        </term_definitions>
        <term_definitions code="at0002">
          <items id="text">Member role</items>
          <items id="description">The part the member plays in the group or organisation.</items>
          <items id="comment">Coding is preferred, for example with SNOMED CT. Corresponds to FHIR CareTeam.participant.role.</items>
        </term_definitions>
        <term_definitions code="at0003">
          <items id="text">Comment</items>
          <items id="description">A note about the membership.</items>
        </term_definitions>
      </children>
