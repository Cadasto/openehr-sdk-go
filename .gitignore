# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
.idea/
.vscode/

# Claude Code local settings (per-user, not committed)
.claude/settings.local.json

# Codebase-memory MCP server local cache (per-user, not committed)
.codebase-memory/

# git worktrees (per-user; never tracked even when checked out inside
# the repo). Covers ad-hoc local worktrees and Superpowers/worktree-
# style scratch directories.
worktrees/
.worktrees/
_scratch*

# Build output
bin/
/lint-aql

# Documentation site (MkDocs). Brand files are fetched by `make docs-sync`
# from Cadasto/docs-theme at the commit in sources.json — do not commit them.
/site/
/.fetched/
/.cache/
/pages/stylesheets/tokens.css
/pages/stylesheets/material.css
/pages/stylesheets/landing.css
/overrides/home.html
/overrides/partials/copyright.html
/pages/assets/cadasto-mark.png
# scripts/sync_sources.py writes each fetched file through a `<dest>.tmp`
# sibling; a killed sync leaves one behind. (`*.tmp` further down catches
# these too — these keep the docs block standing on its own.)
/pages/stylesheets/*.tmp
/pages/assets/*.tmp
/overrides/*.tmp
/overrides/partials/*.tmp

# OS
.DS_Store
Thumbs.db
tmp/
.tmp/

# bmmgen / gofmt / docs-sync atomic-write tempfiles
*.tmp
# AQL parser codegen scratch dirs (make aqlgen / aqlgen-verify)
openehr/aql/parse/gen.tmp/
openehr/aql/parse/gen.verify/
