<?xml version="1.0" encoding="UTF-8"?>
<!-- A root element in a namespace of no openEHR schema, and every element in it. The reader's default mode reads each, by its local name, as the element of that name in the http://schemas.openehr.org/v1 namespace, and its strict mode refuses them. root-namespace.read.opt is how the reader reads it. SDK-authored. -->
<template xmlns="urn:x-openehr-sdk-go:test:foreign" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <language>
        <terminology_id>
            <value>ISO_639-1</value>
        </terminology_id>
        <code_string>en</code_string>
    </language>
    <template_id>
        <value>sdk.reader_root_namespace.v0</value>
    </template_id>
    <concept>sdk.reader_root_namespace.v0</concept>
    <definition>
        <rm_type_name>CLUSTER</rm_type_name>
        <occurrences>
            <lower>1</lower>
            <upper>1</upper>
        </occurrences>
        <node_id>at0000</node_id>
        <attributes xsi:type="C_MULTIPLE_ATTRIBUTE">
            <rm_attribute_name>items</rm_attribute_name>
            <existence>
                <lower>0</lower>
                <upper>1</upper>
            </existence>
            <children xsi:type="C_COMPLEX_OBJECT">
                <rm_type_name>ELEMENT</rm_type_name>
                <occurrences>
                    <lower>0</lower>
                    <upper>1</upper>
                </occurrences>
                <node_id>at0001</node_id>
            </children>
            <cardinality>
                <is_ordered>false</is_ordered>
                <is_unique>false</is_unique>
                <interval>
                    <lower>0</lower>
                    <upper_unbounded>true</upper_unbounded>
                </interval>
            </cardinality>
        </attributes>
        <archetype_id>
            <value>openEHR-EHR-CLUSTER.sdk_reader.v0</value>
        </archetype_id>
        <term_definitions code="at0000">
            <items id="text">Reader</items>
        </term_definitions>
    </definition>
</template>
