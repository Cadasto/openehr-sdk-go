            </children>
            <!-- An item typed C_CODE_PHRASE that binds the prefix p, bound around it to another namespace, with an rm_type_name of its own: the object a C_CODE_PHRASE of what the item holds. -->
            <children xsi:type="C_COMPLEX_OBJECT">
                <rm_type_name>ELEMENT</rm_type_name>
                <occurrences>
