        <attributes xsi:type="C_MULTIPLE_ATTRIBUTE">
            <rm_attribute_name>items</rm_attribute_name>
            <existence>
                <lower>0</lower>
                <upper>1</upper>
            </existence>
            <!-- A <children> typed C_SINGLE_ATTRIBUTE, with an attribute's members: a C_COMPLEX_OBJECT leaf of its rm_type_name, occurrences and node_id. -->
            <children xsi:type="C_COMPLEX_OBJECT">
                <rm_type_name>ELEMENT</rm_type_name>
                <occurrences>
                    <lower>0</lower>
                    <upper>1</upper>
