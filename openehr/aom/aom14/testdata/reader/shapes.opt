<?xml version="1.0" encoding="UTF-8"?>
<!-- Shapes the AM Release-1.4 schemas do not allow inside a definition, which the
     reader's default mode reads as the deprecated template parser does, and its
     strict mode refuses. shapes.read.opt is how the reader reads it. SDK-authored. -->
<template xmlns="http://schemas.openehr.org/v1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <language>
        <terminology_id>
            <value>ISO_639-1</value>
        </terminology_id>
        <code_string>en</code_string>
    </language>
    <template_id>
        <value>sdk.reader_shapes.v0</value>
    </template_id>
    <concept>sdk.reader_shapes.v0</concept>
    <definition>
        <rm_type_name>CLUSTER</rm_type_name>
        <occurrences>
            <lower>1</lower>
            <upper>1</upper>
        </occurrences>
        <node_id>at0000</node_id>
        <!-- No type, a cardinality: a C_MULTIPLE_ATTRIBUTE. -->
        <attributes>
            <rm_attribute_name>items</rm_attribute_name>
            <existence>
                <lower>0</lower>
                <upper>1</upper>
            </existence>
            <!-- No type, no archetype id: a C_COMPLEX_OBJECT. -->
            <children>
                <rm_type_name>ELEMENT</rm_type_name>
                <occurrences>
                    <lower>0</lower>
                    <upper>1</upper>
                </occurrences>
                <node_id>at0001</node_id>
                <!-- An empty type: a C_SINGLE_ATTRIBUTE. -->
                <attributes xsi:type="">
                    <rm_attribute_name>value</rm_attribute_name>
                    <existence>
                        <lower>0</lower>
                        <upper>1</upper>
                    </existence>
                    <!-- A type with white space around it. -->
                    <children xsi:type=" C_COMPLEX_OBJECT ">
                        <rm_type_name>DV_TEXT</rm_type_name>
                        <occurrences>
                            <lower>1</lower>
                            <upper>1</upper>
                        </occurrences>
                        <node_id/>
                        <!-- A type under a prefix bound to another namespace: a C_SINGLE_ATTRIBUTE. -->
                        <attributes xmlns:xsi="http //www.w3.org/2001/XMLSchema-instance" xsi:type="C_SINGLE_ATTRIBUTE">
                            <rm_attribute_name>value</rm_attribute_name>
                            <existence>
                                <lower>1</lower>
                                <upper>1</upper>
                            </existence>
                            <children xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="C_PRIMITIVE_OBJECT">
                                <rm_type_name>STRING</rm_type_name>
                                <occurrences>
                                    <lower>1</lower>
                                    <upper>1</upper>
                                </occurrences>
                                <node_id/>
                                <!-- A bare type attribute and no type in the XSI namespace: no item. -->
                                <item type="C_STRING">
                                    <list>text</list>
                                </item>
                            </children>
                        </attributes>
                    </children>
                </attributes>
            </children>
            <!-- No type, an archetype id: a C_ARCHETYPE_ROOT. -->
            <children>
                <rm_type_name>CLUSTER</rm_type_name>
                <occurrences>
                    <lower>0</lower>
                    <upper>1</upper>
                </occurrences>
                <node_id>at0000</node_id>
                <!-- A bare type attribute and no cardinality: a C_SINGLE_ATTRIBUTE. -->
                <attributes type="C_MULTIPLE_ATTRIBUTE">
                    <rm_attribute_name>items</rm_attribute_name>
                    <existence>
                        <lower>0</lower>
                        <upper>1</upper>
                    </existence>
                </attributes>
                <archetype_id>
                    <value>openEHR-EHR-CLUSTER.sdk_inner.v0</value>
                </archetype_id>
            </children>
            <!-- A type no class of the AOM 1.4 constraint model has: a leaf without
                 its attributes. -->
            <children xsi:type="C_FUTURE_OBJECT">
                <rm_type_name>ELEMENT</rm_type_name>
                <occurrences>
                    <lower>0</lower>
                    <upper>1</upper>
                </occurrences>
                <node_id>at0003</node_id>
                <attributes xsi:type="C_SINGLE_ATTRIBUTE">
                    <rm_attribute_name>value</rm_attribute_name>
                    <existence>
                        <lower>0</lower>
                        <upper>1</upper>
                    </existence>
                </attributes>
            </children>
            <!-- A class of another model: a leaf. -->
            <children xsi:type="DV_TEXT">
                <rm_type_name>ELEMENT</rm_type_name>
                <occurrences>
                    <lower>0</lower>
                    <upper>1</upper>
                </occurrences>
                <node_id>at0004</node_id>
            </children>
            <children xsi:type="C_COMPLEX_OBJECT">
                <rm_type_name>ELEMENT</rm_type_name>
                <occurrences>
                    <lower>0</lower>
                    <upper>1</upper>
                </occurrences>
                <node_id>at0005</node_id>
                <attributes xsi:type="C_SINGLE_ATTRIBUTE">
                    <rm_attribute_name>value</rm_attribute_name>
                    <existence>
                        <lower>0</lower>
                        <upper>1</upper>
                    </existence>
                    <children xsi:type="C_COMPLEX_OBJECT">
                        <rm_type_name>DV_BOOLEAN</rm_type_name>
                        <occurrences>
                            <lower>1</lower>
                            <upper>1</upper>
                        </occurrences>
                        <node_id/>
                        <attributes xsi:type="C_SINGLE_ATTRIBUTE">
                            <rm_attribute_name>value</rm_attribute_name>
                            <existence>
                                <lower>1</lower>
                                <upper>1</upper>
                            </existence>
                            <children xsi:type="C_PRIMITIVE_OBJECT">
                                <rm_type_name>BOOLEAN</rm_type_name>
                                <occurrences>
                                    <lower>1</lower>
                                    <upper>1</upper>
                                </occurrences>
                                <node_id/>
                                <!-- A type of no primitive class: no item. -->
                                <item xsi:type="C_FUTURE_BOOLEAN">
                                    <true_valid>true</true_valid>
                                </item>
                            </children>
                        </attributes>
                    </children>
                </attributes>
            </children>
            <cardinality>
                <is_ordered>false</is_ordered>
                <is_unique>false</is_unique>
                <interval>
                    <lower>0</lower>
                    <upper_unbounded>true</upper_unbounded>
                </interval>
            </cardinality>
        </attributes>
        <archetype_id>
            <value>openEHR-EHR-CLUSTER.sdk_reader.v0</value>
        </archetype_id>
        <term_definitions code="at0000">
            <items id="text">Reader</items>
        </term_definitions>
    </definition>
</template>
