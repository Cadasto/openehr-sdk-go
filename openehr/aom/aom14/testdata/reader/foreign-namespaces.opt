<?xml version="1.0" encoding="UTF-8"?>
<!-- Elements below the root in a namespace of no openEHR schema, which the deprecated template parser, reading no namespace, reads as openEHR ones: a definition in another default namespace, an item in a third, elements under a prefix bound to another namespace, and elements under a prefix no declaration binds. The reader's default mode reads each as the element of that name in the http://schemas.openehr.org/v1 namespace, and its strict mode refuses them. foreign-namespaces.read.opt is how the reader reads it. SDK-authored. -->
<template xmlns="http://schemas.openehr.org/v1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:f="urn:x-openehr-sdk-go:test:foreign">
    <language>
        <terminology_id>
            <value>ISO_639-1</value>
        </terminology_id>
        <code_string>en</code_string>
    </language>
    <template_id>
        <value>sdk.reader_foreign_namespaces.v0</value>
    </template_id>
    <concept>sdk.reader_foreign_namespaces.v0</concept>
    <definition xmlns="urn:x-openehr-sdk-go:test:other">
        <rm_type_name>CLUSTER</rm_type_name>
        <occurrences>
            <lower>1</lower>
            <upper>1</upper>
        </occurrences>
        <node_id>at0000</node_id>
        <attributes xsi:type="C_MULTIPLE_ATTRIBUTE">
            <rm_attribute_name>items</rm_attribute_name>
            <existence>
                <lower>0</lower>
                <upper>1</upper>
            </existence>
            <!-- An item in a third namespace, which it declares as the default one. -->
            <children xsi:type="C_COMPLEX_OBJECT">
                <rm_type_name>ELEMENT</rm_type_name>
                <occurrences>
                    <lower>0</lower>
                    <upper>1</upper>
                </occurrences>
                <node_id>at0001</node_id>
                <attributes xsi:type="C_SINGLE_ATTRIBUTE">
                    <rm_attribute_name>value</rm_attribute_name>
                    <existence>
                        <lower>0</lower>
                        <upper>1</upper>
                    </existence>
                    <children xsi:type="C_PRIMITIVE_OBJECT">
                        <rm_type_name>STRING</rm_type_name>
                        <occurrences>
                            <lower>1</lower>
                            <upper>1</upper>
                        </occurrences>
                        <node_id/>
                        <item xmlns="urn:example" xsi:type="C_STRING">
                            <list>a</list>
                            <list>b</list>
                        </item>
                    </children>
                </attributes>
            </children>
            <!-- Elements under the prefix f, which the root binds to another namespace. -->
            <f:children xsi:type="C_COMPLEX_OBJECT">
                <f:rm_type_name>ELEMENT</f:rm_type_name>
                <f:occurrences>
                    <f:lower>0</f:lower>
                    <f:upper>1</f:upper>
                </f:occurrences>
                <f:node_id>at0002</f:node_id>
                <f:attributes xsi:type="C_SINGLE_ATTRIBUTE">
                    <f:rm_attribute_name>value</f:rm_attribute_name>
                    <f:existence>
                        <f:lower>0</f:lower>
                        <f:upper>1</f:upper>
                    </f:existence>
                    <f:children xsi:type="C_PRIMITIVE_OBJECT">
                        <f:rm_type_name>INTEGER</f:rm_type_name>
                        <f:occurrences>
                            <f:lower>1</f:lower>
                            <f:upper>1</f:upper>
                        </f:occurrences>
                        <f:node_id/>
                        <f:item xsi:type="C_INTEGER">
                            <f:range>
                                <f:lower>0</f:lower>
                                <f:upper>9</f:upper>
                            </f:range>
                        </f:item>
                    </f:children>
                </f:attributes>
            </f:children>
            <!-- Elements under the prefix g, which no declaration binds. -->
            <g:children xsi:type="C_COMPLEX_OBJECT">
                <g:rm_type_name>ELEMENT</g:rm_type_name>
                <g:occurrences>
                    <g:lower>0</g:lower>
                    <g:upper>1</g:upper>
                </g:occurrences>
                <g:node_id>at0003</g:node_id>
                <g:attributes xsi:type="C_SINGLE_ATTRIBUTE">
                    <g:rm_attribute_name>value</g:rm_attribute_name>
                    <g:existence>
                        <g:lower>0</g:lower>
                        <g:upper>1</g:upper>
                    </g:existence>
                    <g:children xsi:type="C_PRIMITIVE_OBJECT">
                        <g:rm_type_name>BOOLEAN</g:rm_type_name>
                        <g:occurrences>
                            <g:lower>1</g:lower>
                            <g:upper>1</g:upper>
                        </g:occurrences>
                        <g:node_id/>
                        <g:item xsi:type="C_BOOLEAN">
                            <g:true_valid>true</g:true_valid>
                            <g:false_valid>false</g:false_valid>
                        </g:item>
                    </g:children>
                </g:attributes>
            </g:children>
            <cardinality>
                <is_ordered>false</is_ordered>
                <is_unique>false</is_unique>
                <interval>
                    <lower>0</lower>
                    <upper_unbounded>true</upper_unbounded>
                </interval>
            </cardinality>
        </attributes>
        <archetype_id>
            <value>openEHR-EHR-CLUSTER.sdk_reader.v0</value>
        </archetype_id>
        <term_definitions code="at0000">
            <items id="text">Reader</items>
        </term_definitions>
    </definition>
</template>
